{
  "name": "health-kiosk-demo",
  "productName": "小安站点咨询顾问 V1.5.19",
  "version": "1.5.19",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:skills": "node --test tests/skills.test.mjs",
    "test:desktop": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/speech-service.cjs && node --check electron/speech-worker.cjs && node --check electron/vits-duration-contract.cjs && node --check electron/avatar-service.cjs && node --check electron/frame-stream.cjs && node --check electron/deepseek-client.cjs && node --check electron/soak-monitor.cjs",
    "test:speech": "node scripts/test-open-source-speech.cjs",
    "test:packaged-speech": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-packaged-speech.cjs",
    "test:visemes": "node scripts/test-visemes.cjs",
    "test:viseme-alignment": "node scripts/audit-viseme-alignment.cjs",
    "audit:vits-durations": "node scripts/audit-vits-duration-capability.cjs",
    "mfa:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-mfa-aligner.ps1",
    "mfa:align": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-mfa-alignment.ps1",
    "mfa:audit": "node scripts/audit-mfa-viseme-alignment.cjs",
    "audit:size": "node scripts/audit-package-size.cjs",
    "test:desktop-assets": "node --test tests/desktop-assets.test.mjs",
    "test:avatar": "node --test tests/avatar-service.test.mjs",
    "test:avatar-continuity": "node --test tests/avatar-continuity.test.mjs",
    "test:avatar-realtime": "node --test tests/avatar-realtime.test.mjs tests/streaming-speech.test.mjs",
    "test:controls": "node --test tests/controls-cleanup.test.mjs",
    "test:assessment": "node --test tests/assessment-understanding.test.mjs tests/assessment-flow.test.mjs tests/skill-runtime.test.mjs tests/personalized-plan.test.mjs",
    "test:harness": "node --test tests/harness-runtime.test.mjs",
    "test:virtual-senior": "node --test tests/virtual-senior.test.mjs",
    "test:virtual-senior-asr": "node scripts/run-virtual-senior-asr-gate.cjs",
    "ditto:setup-local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-ditto-local-gpu.ps1",
    "ditto:setup-trt": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-ditto-tensorrt.ps1",
    "ditto:download-local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download-ditto-models-xet.ps1",
    "ditto:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-ditto-local-gpu.ps1",
    "ditto:local-trt": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-ditto-tensorrt.ps1",
    "ditto:test-frames": "node scripts/test-ditto-frame-stream.mjs",
    "ditto:test-cancel": "node scripts/test-ditto-frame-stream.mjs --cancel-after-frames=10",
    "ditto:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-ditto-tunnel.ps1",
    "desktop": "cross-env VITE_DEV_SERVER_URL=http://localhost:4173 electron . --windowed",
    "desktop:full": "cross-env VITE_DEV_SERVER_URL=http://localhost:4173 electron .",
    "dist:win": "pnpm run build && electron-builder --win portable --x64",
    "dist:mac": "pnpm run build && electron-builder --mac --arm64",
    "dist:mac:dir": "pnpm run build && electron-builder --mac dir --arm64"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sherpa-onnx-node": "^1.13.6",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "electron": "37.2.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.clife.xiaoan.healthkiosk",
    "productName": "小安站点咨询顾问 V1.5.19",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17",
        "to": "models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17"
      },
      {
        "from": "models/sherpa-onnx-vits-zh-ll",
        "to": "models/sherpa-onnx-vits-zh-ll"
      },
      {
        "from": "skills/station-advisor-global-v2",
        "to": "skills/station-advisor-global-v2"
      },
      {
        "from": "skills/station-public-info-v1",
        "to": "skills/station-public-info-v1"
      },
      {
        "from": "skills/member-self-service-v1",
        "to": "skills/member-self-service-v1"
      },
      {
        "from": "skills/identity-and-permission-v1",
        "to": "skills/identity-and-permission-v1"
      },
      {
        "from": "skills/health-general-guidance-v1",
        "to": "skills/health-general-guidance-v1"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "XiaoAn-Health-Kiosk-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "XiaoAn-Health-Kiosk-${version}-${arch}.${ext}",
      "identity": null
    },
    "portable": {
      "artifactName": "XiaoAn-Health-Kiosk-${version}-${arch}.${ext}"
    }
  }
}
